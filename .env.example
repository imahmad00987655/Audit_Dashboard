# ── Backend (copy to project root as .env) ──────────────────────────
PORT=5057
CORS_ORIGIN=http://localhost:3033
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=8h

# Source procurement APIs
DATA_URL=http://192.168.1.209:6070/callcenterreportdata
PO2GRN_URL=http://192.168.1.209:6070/callcenterreportdata/po2grn
CACHE_TTL_MS=300000
CACHE_STALE_MAX_MS=1800000

# MySQL (users, permissions, chat memory, report recipients)
DB_HOST=192.168.1.209
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Audit_Dashboard

# Audit Assistant (OpenAI) — required for chatbot
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: day-end report email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORT_EMAIL_RECIPIENTS=

# Risk / split-PO heuristics
APPROVAL_LIMIT_PKR=500000
SPLIT_WINDOW_DAYS=3

# ── Frontend (copy to frontend/.env.local) ──────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:5057
